{
    "rules": {
        ".read": false,
        ".write": false,
        "currentComment": {
            ".read": true,
            ".write": true,
            ".validate": "!newData.exists() || newData.hasChildren(['type', 'timestamp'])"
        },
        "hypeTrain": {
            ".read": true,
            ".write": true
        },
        "debug_logs": {
            "hype_train": {
                "$logId": {
                    ".read": false,
                    ".write": true,
                    ".validate": "newData.hasChildren(['timestamp'])"
                }
            }
        }
    }
}